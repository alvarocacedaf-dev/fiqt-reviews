# Opcional: permite ejecutar Playwright contra una URL ya desplegada.
# Si se omite, Playwright inicia el servidor local de Next.js.
E2E_BASE_URL=http://127.0.0.1:3000

# Cuenta estudiantil exclusiva para pruebas de solo lectura.
# Nunca uses una cuenta personal ni guardes estas credenciales en Git.
E2E_STUDENT_EMAIL=cuenta_pruebas@uni.pe
E2E_STUDENT_PASSWORD=contraseña_de_pruebas
